{
    "name": "nestjs-boilerplate",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"**/*.{json,ts,js,mjs,md}\"",
        "start": "NODE_ENV=development nest start",
        "start:dev": "NODE_ENV=development nest start --watch",
        "start:debug": "NODE_ENV=development nest start --debug --watch",
        "start:prod": "NODE_ENV=production node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "db:up": "docker compose up -d",
        "db:down": "docker compose down",
        "db:restart": "docker compose down && docker compose up -d",
        "db:logs": "docker compose logs -f postgres_test",
        "db:exec": "docker compose exec postgres psql -U postgres -d postgres_test",
        "test": "pnpm db:up && jest && pnpm db:down",
        "test:watch": "pnpm db:up && jest --watch && pnpm db:down",
        "test:cov": "pnpm db:up && jest --coverage && pnpm db:down",
        "test:debug": "pnpm db:up && node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand && pnpm db:down",
        "test:e2e": "pnpm db:up && jest --config ./jest-e2e.json && pnpm db:down"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.4",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.4",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/mapped-types": "^2.1.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.4",
        "@nestjs/typeorm": "^11.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "joi": "^17.13.3",
        "nestjs-pino": "^4.4.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.16.3",
        "pino-http": "^10.5.0",
        "pino-pretty": "^13.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^0.3.25"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.31.0",
        "@nestjs/cli": "^11.0.7",
        "@nestjs/schematics": "^11.0.5",
        "@nestjs/testing": "^11.1.4",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.13.0",
        "@swc/jest": "^0.2.39",
        "@types/express": "^5.0.3",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.16.4",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.31.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.5.1",
        "globals": "^16.3.0",
        "jest": "^29.7.0",
        "prettier": "^3.6.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.3",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.37.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "testPathIgnorePatterns": [
            ".*\\.e2e-spec\\.ts$"
        ],
        "transform": {
            "^.+\\.(t|j)s$": [
                "@swc/jest"
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s",
            "!**/*.e2e-spec.ts"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
